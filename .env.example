# ==============================================================================
# APEX DENTAL CARE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for production or local overrides
# ==============================================================================

# Database Connection (MySQL 8 in Production, SQLite supported in Local Dev)
DATABASE_URL=mysql+mysqldb://dental_user:dental_password@127.0.0.1:3306/dental_clinic
# For local SQLite dev without MySQL: sqlite:///./dental.db

# Security & Cryptography (Generate strong random 64-char keys)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_cryptographically_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Environment (production, staging, development)
ENVIRONMENT=production
DEBUG=false

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://clinic.example.com

# File & Document Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=15728640

# Clinic Information & PDF Letterhead Branding
CLINIC_NAME=Apex Dental Care
CLINIC_ADDRESS=Suite 400, Medical Plaza, Metro City
CLINIC_PHONE=+91 98765 43210
CLINIC_EMAIL=care@apexdental.in

# ==============================================================================
# ONLINE PAYMENT GATEWAY CONFIGURATION (Razorpay / India Gateway / Mock Sandbox)
# ==============================================================================
# Supported providers: "razorpay", "mock" (default for offline dev/tests)
PAYMENT_PROVIDER=razorpay
# Mode: "test" or "live"
PAYMENT_MODE=test
# Gateway Credentials (NEVER commit real production secrets!)
PAYMENT_KEY_ID=rzp_test_placeholder_key_id
PAYMENT_KEY_SECRET=rzp_test_placeholder_key_secret
PAYMENT_WEBHOOK_SECRET=rzp_test_webhook_secret_key
# Transaction Currency (INR for India-first deployment)
PAYMENT_CURRENCY=INR
# Callback URLs
PAYMENT_SUCCESS_URL=https://clinic.example.com/billing
PAYMENT_FAILURE_URL=https://clinic.example.com/billing
